    "@astryxdesign/theme-stone": "0.7.16",
    "@hookform/resolvers": "7.0.7",
    "@lingui/core": "6.12.0",
    "@lingui/message-utils": "6.12.0",
    "@lingui/react": "6.12.0",
    "@stylexjs/stylex": "0.19.2",
    "@tanstack/react-query": "5.108.0",
    "katex": "0.19.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-router": "8.5.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astryxdesign/build": "0.7.16",
    "@astryxdesign/cli": "0.7.16",
    "@babel/core": "7.29.13",
    "@lingui/babel-plugin-lingui-macro": "6.12.0",
    "@lingui/cli": "6.12.0",
    "@lingui/format-po": "6.12.0",
    "@lingui/vite-plugin": "6.12.0",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@stylexjs/babel-plugin": "0.19.2",
    "@stylexjs/unplugin": "0.19.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser": "5.1.1",
    "@vitest/browser-playwright": "5.1.1",
    "jsdom": "31.0.1",
    "playwright": "1.65.1",
    "storybook": "10.6.7",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "e2e:serve": "node scripts/e2e-serve.mjs",
    "test": "vitest run",
    "test:stories": "vitest run --config vitest.stories.config.ts src/ui && vitest run --config vitest.stories.config.ts src/screens",
    "typecheck": "tsc -b",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1",
    "theme": "node scripts/tokens-to-theme.ts && astryx theme build src/theme/tesselle.ts --out src/theme/built/tesselle.css --icons-specifier ../../ui/icons/registry"
  }
}
