# Copy to .env in llm_service/ and fill in the team key. Keep .env private.
LLM_BASE_URL=https://llm.felcloud.io/v1
LLM_API_KEY=
COMPACT_MODEL=qwen2.5-3b
MID_SIZE_MODEL=qwen2.5-coder-7b
RAG_URL=http://127.0.0.1:8001
QUOTA_REMAINING_HEADER=X-Quota-Remaining
QUOTA_LIMIT_HEADER=X-Quota-Limit
LLM_MAX_CONCURRENCY=2
LLM_REQUESTS_PER_MINUTE=20
COMPACT_TIMEOUT_S=40
MID_TIMEOUT_S=90
REQUEST_TIMEOUT_S=45
FALLBACK_TIMEOUT_S=5
LEARNER_REQUESTS_PER_MIN=6
LEARNER_BURST=4
CACHE_PATH=ednova_cache.sqlite3
LEARNER_DB_PATH=ednova_learners.sqlite3
REQUEST_LOG_PATH=logs/requests.jsonl
# TODO(later): a support line the team has verified from an official Tunisian source. Leave empty until verified.
WELLBEING_CONTACT=
