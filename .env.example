# Copy to .env before running: docker compose up --build

POSTGRES_USER=ednova
POSTGRES_PASSWORD=ednova
POSTGRES_DB=ednova
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Required for connected AI responses. Leave blank for UI/dependency startup only.
LLM_API_KEY=
LLM_BASE_URL=https://llm.felcloud.io/v1
COMPACT_MODEL=qwen2.5-3b
MID_SIZE_MODEL=qwen2.5-coder-7b

POSTGRES_PORT=5432
RAG_PORT=8001
LLM_PORT=8100
BACKEND_PORT=9999
WEB_PORT=4175
REDIS_PORT=6379
