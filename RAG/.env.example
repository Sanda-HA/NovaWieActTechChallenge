# Copy to .env or export in your shell. NEVER commit the real key.

# "local"    -> offline hashing embeddings (no network, no quota). Good for dev and the scaled-down demo.
# "platform" -> the organisers' OpenAI-compatible /v1/embeddings endpoint (separately metered quota).
EMBED_BACKEND=local

# Only needed for EMBED_BACKEND=platform (values come from the organisers).
# Base URL WITHOUT the trailing /v1 : the code appends /v1/embeddings itself.
PLATFORM_BASE_URL=
PLATFORM_API_KEY=
EMBED_MODEL=replace-with-model-listed-by-/v1/models
EMBED_BATCH_SIZE=16

# Optional overrides
INDEX_DIR=index
