  "components": [
    {
      "name": "NavRail",
      "group": "Navigation",
      "summary": "The app’s main navigation: a floating pill of icon tiles on the left of the screen on laptops, and a labelled bottom bar on phones."
    },
    {
      "name": "HomeOverview",
      "group": "Pages",
      "summary": "The home screen as one coaching view: the weakest chapter, today’s time, the streak and a single next step, with nothing to sell."
    },
    {
      "name": "Button",
      "group": "Actions",
      "summary": "The one button: primary (argile) for the single action a view is for, secondary (outlined) by default, quiet for low-emphasis actions, danger for deleting the…"
    },
    {
      "name": "TextField",
      "group": "Actions",
      "summary": "A labelled input with helper text and an inline error that says how to fix it; password fields get a show/hide toggle."
    },
    {
      "name": "MathText",
      "group": "Foundations",
      "summary": "Typesets maths with KaTeX: every formula in EdNova goes through it, so no raw x^2 or sqrt() ever reaches the screen."
    },
    {
      "name": "Icon",
      "group": "Foundations",
      "summary": "EdNova’s own line icons: a 24px grid, 1.75 stroke, round caps and joins, drawn in currentColor so they take the colour of their text."
    },
    {
      "name": "Mascot",
      "group": "Foundations",
      "summary": "Nova, EdNova’s axolotl, in five states: welcoming, thinking, cheering, encouraging and calm."
    },
    {
      "name": "AnswerBubble",
      "group": "Tutor",
      "summary": "One tutor answer: the badge saying where it comes from, the AI label, typeset text, the textbook pages it cites, then next step, feedback and receipt."
    },
    {
      "name": "StudentMessage",
      "group": "Tutor",
      "summary": "The student’s own message: a sunken tile on the right of the conversation, with formulas typeset like everything else."
    },
    {
      "name": "AnswerBadge",
      "group": "Tutor",
      "summary": "Says where an answer comes from, in one of six fixed variants, always with an icon and words so it never relies on colour."
    },
    {
      "name": "SourceChip",
      "group": "Tutor",
      "summary": "The textbook passage an answer comes from: book plus a page tile, EdNova’s visual signature under every course answer."
    },
    {
      "name": "AiLabel",
      "group": "Tutor",
      "summary": "The small, always-visible “réponse générée par IA” mark that sits on every AI reply."
    },
    {
      "name": "StageIndicator",
      "group": "Tutor",
      "summary": "The live thinking steps of a streamed answer: four tesserae that set one by one while Nova thinks."
    },
    {
      "name": "Composer",
      "group": "Tutor",
      "summary": "The question field: Libre or Guidé mode, Enter to send, Shift+Enter for a new line, and a live typeset preview of any $…$ maths."
    },
    {
      "name": "NextStepChip",
      "group": "Tutor",
      "summary": "One suggested next move after an answer (practise, review a prerequisite, or move on); tapping it sends the ready-made message."
    },
    {
      "name": "FeedbackControl",
      "group": "Tutor",
      "summary": "Thumbs up, or thumbs down with one reason (wrong, unclear, too long, not my level), then a quiet thank-you."
    },
    {
      "name": "Receipt",
      "group": "Tutor",
      "summary": "“Comment cette réponse a été faite”: model calls, tokens, cache hits, duration and the agent’s steps, folded by default."
    },
    {
      "name": "BusyBanner",
      "group": "Tutor",
      "summary": "Busy mode without an error: a calm countdown that retries on its own, and the course excerpt in the meantime."
    },
    {
      "name": "WellbeingMessage",
      "group": "Tutor",
      "summary": "The calm reply to a distress message: dusk surface, pebble shape, Nova at rest, generous text, no buttons and never any maths."
    },
    {
      "name": "HintLadder",
      "group": "Guided practice",
      "summary": "Guided mode drawn as a staircase of tesserae: each hint opened is a step climbed, and “Ma réponse” is the top step."
    },
    {
      "name": "GuidedActionBar",
      "group": "Guided practice",
      "summary": "Guided mode’s three moves (a hint, my answer, a new question) next to the compact ladder."
    },
    {
      "name": "VerdictCard",
      "group": "Guided practice",
      "summary": "The verdict on an explanation or an attempt: what is missing, then a guiding question, never the answer."
    },
    {
      "name": "QuizCard",
      "group": "Onboarding",
      "summary": "The diagnostic quiz: one question per card, number keys 1 to 4, then a result card that sets the learning style and starting level."
    },
    {
      "name": "ChoiceTile",
      "group": "Onboarding",
      "summary": "A large selectable tile for onboarding and settings choices: one of a set (radio) or several (checkbox)."
    },
    {
      "name": "MasteryTessera",
      "group": "Progress",
      "summary": "One chapter’s mastery as a 2×2 tessera that fills from the bottom: 0 tiles (dashed), 1, 2 or 4."
    },
    {
      "name": "MasteryRow",
      "group": "Progress",
      "summary": "One chapter in the progress list: tessera, name, attempts / solved / confusions, a three-segment bar and the level word."
    },
    {
      "name": "ChapterMap",
      "group": "Progress",
      "summary": "The chapters as a mosaic floor: one tile per chapter coloured by mastery, prerequisites drawn as grout lines that never cross a label."
    },
    {
      "name": "StudyTimer",
      "group": "Progress",
      "summary": "Start and stop a study session; minutes today and this week and the streak are shown plainly, as information, never as a score."
    },
    {
      "name": "Streak",
      "group": "Progress",
      "summary": "The streak as a jasmine that grows: bud (1 day), flower (3), bouquet (7), machmoum (14), golden machmoum (30)."
    },
    {
      "name": "AchievementBadge",
      "group": "Progress",
      "summary": "A badge cut from a mosaic material; its shape gains points with rarity: Argile (square), Faïence (octagon), Marbre (8 points), Lapis (12), Or (16)."
    }
  ],
